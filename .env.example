# Google Drive image source (optional).
# Without these, galleries use the local placeholder images in src/assets.
#
# 1. Put all site photography under one Drive folder, with a subfolder per
#    collection (see `driveFolder` in src/content/collections.ts), e.g.
#      Commodore Creations Website/
#        Homepage Hero/
#        Christmas Trees/
#        Mantels/
#        Staircases/
#        Full Home/
#        Tablescapes/
#        Projects/Grand Holiday Entry/ …
# 2. Share the root folder as "Anyone with the link can view".
# 3. Create an API key in Google Cloud with the Drive API enabled, restricted
#    to the Drive API. It stays on the server and is never sent to browsers.
GOOGLE_DRIVE_API_KEY=
# The id at the end of the root folder's URL: drive.google.com/drive/folders/<id>
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# How often (seconds) folder listings are refreshed. Defaults to 3600.
GOOGLE_DRIVE_REVALIDATE_SECONDS=
